<?xml version="1.0" encoding="utf-8"?>
<!--
  Folder publish profile: single-file, framework-dependent, linux-x64.
  Publishing with this profile also fires the InstallInkscapeExtension target
  (auto-installs into ~/.config/inkscape/extensions/plotter-helper-extension/).

  Publish from Rider: right-click PlotterHelper.Cli -> Publish -> pick "linux-x64",
  or: dotnet publish -p:PublishProfile=linux-x64
-->
<Project>
  <PropertyGroup>
    <_PublishProfile>Folder</_PublishProfile>
    <Configuration>Release</Configuration>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishDir>bin\Release\net10.0\linux-x64\publish\</PublishDir>
  </PropertyGroup>
</Project>
<?xml version="1.0" encoding="utf-8"?>
<!--
  Folder publish profile: single-file, SELF-CONTAINED (no .NET runtime needed
  on the target machine), linux-x64. Use when Inkscape hosts don't have the
  .NET 10 runtime installed. Larger binary (~70MB), otherwise identical.
  Also fires InstallInkscapeExtension (auto-install).
-->
<Project>
  <PropertyGroup>
    <_PublishProfile>Folder</_PublishProfile>
    <Configuration>Release</Configuration>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishDir>bin\Release\net10.0\linux-x64\publish-sc\</PublishDir>
  </PropertyGroup>
</Project>
# EditorConfig — https://editorconfig.org
# PlotterHelper: standardized, human-readable coding style.
#
# This file IS the active one. (The old editorconfig.txt was mis-named and
# ignored by every editor — EditorConfig requires the exact name ".editorconfig".)
root = true

# ---------------------------------------------------------------------------
# Defaults for every file
# ---------------------------------------------------------------------------
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Markdown: trailing two-space line breaks are meaningful, so don't strip them.
[*.{md,markdown}]
trim_trailing_whitespace = false

# ---------------------------------------------------------------------------
# C# formatting (matches the existing code: K&R braces, single-line blocks
# preserved, file-scoped namespaces, 4-space indent).
# ---------------------------------------------------------------------------
[*.cs]
# Braces open on their own line (Allman) — the codebase's dominant style:
# `if (x)\n{` not `if (x) {`. Short single-line blocks stay inline via
# csharp_preserve_single_line_blocks below (e.g. `public Vector(...) { X = x; Y = y; }`).
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_anonymous_types = true
# Keep short blocks/statements on one line: `public Vector(double x, double y) { X = x; Y = y; }`
csharp_preserve_single_line_blocks = true
csharp_preserve_single_line_statements = true
# Indentation inside switch / blocks.
csharp_indent_case_content = true
csharp_indent_switch_labels = true
csharp_indent_block_contents = true
csharp_indent_braces = false
# Spacing.
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_before_colon_in_inheritance_clause = true
csharp_space_after_colon_in_inheritance_clause = true
csharp_space_between_method_declaration_parameter_list_parentheses = false
csharp_space_between_method_call_parameter_list_parentheses = false
csharp_space_after_cast = false
csharp_space_around_declaration_statements = false
# File-scoped namespaces everywhere (the whole codebase uses `namespace X;`).
csharp_style_namespace_declarations = file_scoped

# ---------------------------------------------------------------------------
# .NET / C# analyzer style
#
# Severity policy: style rules use `suggestion` (green squiggle in the IDE,
# no build break). This matters because Directory.Build.props sets
# <TreatWarningsAsErrors>true</TreatWarningsAsErrors> — anything at `warning`
# would fail the build, so we only reserve `warning` for rules the codebase
# already fully satisfies. `var` is left at `silent` because the existing code
# uses it inconsistently and we don't want constant noise.
# ---------------------------------------------------------------------------
[*.cs]

# --- this. qualification: off (matches code, which never writes `this.`) ---
dotnet_style_qualification_for_field = false:silent
dotnet_style_qualification_for_property = false:silent
dotnet_style_qualification_for_method = false:silent
dotnet_style_qualification_for_event = false:silent

# --- predefined language types: prefer `int` over `Int32`, `double` over `Double` ---
dotnet_style_predefined_type_for_locals_parameters_members = true:suggestion
dotnet_style_predefined_type_for_member_access = true:suggestion

# --- modifier order + accessibility modifiers required ---
csharp_preferred_modifier_order = public,private,protected,internal,file,static,extern,new,virtual,abstract,sealed,override,readonly,unsafe,required,volatile,async:suggestion
dotnet_style_require_accessibility_modifiers = for_non_interface_members:suggestion

# --- readonly fields: PREFER readonly (code uses `public readonly double X`) ---
dotnet_style_readonly_field = true:suggestion

# --- parentheses: left to the author. Forcing parens onto `a*b + c*d` cluttered
#     simple arithmetic (200+ hits), and stripping the author's clarifying parens
#     fights readability too. So neither add nor remove is suggested — trust the
#     writer's judgment. (Preference kept as never_if_unnecessary but silenced.)
dotnet_style_parentheses_in_arithmetic_binary_operators = never_if_unnecessary:silent
dotnet_style_parentheses_in_relational_binary_operators = never_if_unnecessary:silent
dotnet_style_parentheses_in_other_binary_operators = never_if_unnecessary:silent
dotnet_style_parentheses_in_other_operators = never_if_unnecessary:silent

# --- expression-bodied / initializers (the code uses these) ---
dotnet_style_object_initializer = true:suggestion
dotnet_style_collection_initializer = true:suggestion
dotnet_style_prefer_auto_properties = true:suggestion
dotnet_style_prefer_conditional_expression_over_assignment = false:suggestion   # prefer explicit if/else (more readable)
dotnet_style_prefer_conditional_expression_over_return = false:suggestion
dotnet_style_prefer_compound_assignment = true:suggestion
dotnet_style_prefer_simplified_interpolation = true:suggestion
dotnet_style_prefer_simplified_boolean_expressions = true:suggestion
csharp_prefer_simple_default_expression = true:suggestion
csharp_style_implicit_object_creation_when_type_is_apparent = true:suggestion

# --- tuples / deconstruction ---
dotnet_style_prefer_inferred_tuple_names = true:suggestion
dotnet_style_prefer_inferred_anonymous_type_member_names = true:suggestion
csharp_style_deconstructed_variable_declaration = true:suggestion

# --- locals / functions ---
csharp_style_prefer_local_over_anonymous_function = true:suggestion
csharp_style_prefer_index_operator = true:suggestion
csharp_style_prefer_range_operator = true:suggestion

# --- null handling (code relies on ??, ?. and `is null`) ---
dotnet_style_coalesce_expression = true:suggestion
dotnet_style_null_propagation = true:suggestion
dotnet_style_prefer_is_null_check_over_reference_equality_method = true:suggestion
csharp_style_prefer_null_check_over_type_check = true:suggestion

# --- unused values: discard unused *assignments* (var x = ...; x never used).
#     IDE0058 (unused expression *statement*) is silenced separately below — it
#     fires on every fluent `sb.Append(...)` builder call, which is normal usage,
#     not a bug. ---
csharp_style_unused_value_assignment_preference = discard_variable:suggestion
# csharp_style_unused_value_expression_statement_preference left at default; see IDE0058 below.

# --- var: left unenforced. The existing code mixes `var` and explicit types,
#     and forcing either direction would be noisy and (at warning) would break
#     the build under TreatWarningsAsErrors. Left silent = no nagging. ---
csharp_style_var_for_built_in_types = false:silent
csharp_style_var_when_type_is_apparent = true:silent
csharp_style_var_elsewhere = false:silent

# --- unused usings: keep the file headers tidy. IDE0005 is safe (the build
#     already passes with ImplicitUsings on); left at suggestion so a stray
#     redundant using is a hint, not a build failure. ---
dotnet_diagnostic.IDE0005.severity = suggestion
dotnet_diagnostic.IDE0082.severity = suggestion

# --- silenced: debatable / structural rules that fight the codebase ---
# IDE0290 "use primary constructor": a structural refactor that is risky on
#   readonly structs (Vector/Affine/Curve) and not a readability win. Off.
# IDE0300/IDE0305/IDE0301 "use collection expressions []": a terse modern syntax;
#   the codebase deliberately uses explicit `new List<X> { ... }` for clarity,
#   so the `[]` suggestions are noise. Off.
dotnet_diagnostic.IDE0290.severity = none
dotnet_diagnostic.IDE0300.severity = none
dotnet_diagnostic.IDE0305.severity = none
dotnet_diagnostic.IDE0301.severity = none
# IDE0058 "expression value is never used": fires on every fluent builder call
#   (e.g. `sb.Append(...)` returning the builder, which is intentional side-effect
#   usage). Not a real issue; silence it.
# IDE0028 "collection initialization can be simplified": pushes the terse `[]`
#   collection-expression form on code that already uses explicit, readable
#   `new List<X> { ... }` initializers — overlaps the IDE0300 we silenced. Off.
dotnet_diagnostic.IDE0058.severity = none
dotnet_diagnostic.IDE0028.severity = none

# ---------------------------------------------------------------------------
# Test project overrides
# ---------------------------------------------------------------------------
# GeneratedRegex (SYSLIB1045) is a compile-time source-gen hint that adds
# boilerplate for little value in unit-test code; silence it in tests only.
# CA1861 (hoist constant array args to static readonly) and CA1846 (AsSpan over
# Substring) are hot-path micro-perf rules that don't matter for one-shot test
# setup/parse code, and fixing them in tests risks juggling TryParse overloads.
[tests/**.cs]
dotnet_diagnostic.SYSLIB1045.severity = none
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA1846.severity = none

# ---------------------------------------------------------------------------
# Bench project overrides
# ---------------------------------------------------------------------------
# CA1822 (make member static): BenchmarkDotNet [ParamsSource] must be an instance
# member, so SvgFiles() cannot be static — this is a false positive in the bench.
[bench/**.cs]
dotnet_diagnostic.CA1822.severity = none